# ============================================================
# MASTER ENV FILE - All variables for all components
# ============================================================
# Each component also has its own .env.example with only
# the variables it needs. See: app/, api/, etl/, supabase/
# ============================================================

# ============================================================
# SUPABASE (Required)
# Get from: https://supabase.com/dashboard/project/_/settings/api
# ============================================================

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Next.js public vars (same values, prefixed for client-side access)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# DATABASE (Required for migrations)
# Get from: https://supabase.com/dashboard/project/_/settings/database
# Click "Connection string" > "URI"
# ============================================================

# URL-encode special characters in password:
#   @  →  %40    #  →  %23    !  →  %21    $  →  %24
DATABASE_URL=postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# ============================================================
# AI / LLM (Required)
# Get from: https://console.anthropic.com/settings/keys
# ============================================================

ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: Override model (default: claude-sonnet-4-20250514)
# LLM_MODEL=claude-sonnet-4-20250514

# ============================================================
# API BACKEND (Required)
# ============================================================

NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ============================================================
# SERVER (Optional)
# ============================================================

# PORT=3000
# HOSTNAME=localhost

# ============================================================
# UI CONFIG (Optional)
# ============================================================

# Show "View SQL" button on widgets (useful for demos/debugging)
NEXT_PUBLIC_SHOW_SQL=true

# ============================================================
# ETL CONFIG (Optional - all have sensible defaults)
# ============================================================

# Fuzzy matching thresholds (0-100 for int, 0.0-1.0 for float)
# ETL_PRODUCT_THRESHOLD=0.70
# ETL_CATEGORY_THRESHOLD=85
# ETL_LOCATION_THRESHOLD=75
# ETL_CHANNEL_THRESHOLD=70

# LLM category classification thresholds
# AUTO_APPROVE_THRESHOLD=0.9   # Auto-approve if confidence >= this
# REVIEW_THRESHOLD=0.7         # Flag for review if confidence < this

# Retry and batch settings
# ETL_MAX_RETRIES=3
# ETL_RETRY_DELAY=1.0
# ETL_BATCH_SIZE=100
